# 复制成 .env 后填写。所有变量由 server/src/platform/config/index.ts 校验,缺失或格式错误启动即失败。
# 注释掉的是可选项,等号右边是默认值;详细说明在 config/index.ts 的注释里。

# ============================================================
# 服务
# ============================================================
# 后端端口;生产环境是 nginx 对外的端口,两者同号。一台机器跑多个项目时按项目分段
PORT=7101
# 前端 dev server 端口
WEB_PORT=7102
# 只想本机访问就改成 127.0.0.1
# HOST=0.0.0.0
# 一台 nginx 按路径反代多个应用时才设,如 /order
# CONTEXT_PATH=
# NODE_ENV=development

# ============================================================
# 数据库 —— 开发 / 测试 / 生产各自配置,模板不会自动拉起数据库
# schema 名按环境加后缀: <项目>_dev / <项目>_test / <项目>_prod(同一项目的几套环境排在一起)
# 本机想临时起一个 PG: pnpm db up(仅限能跑 docker 的机器,沙箱里由平台提供)
# ============================================================
# 必填,如 postgresql://用户:密码@主机:5432/库名
DATABASE_URL=
# 必填
DATABASE_SCHEMA=aibase_dev

# ============================================================
# 认证
# ============================================================
# 生产必填,至少 32 字节;开发留空会随机生成(重启后需重新登录)
JWT_SECRET=
# 初始管理员密码,上线前必须改
SEED_ADMIN_PASSWORD=admin12345
# 令牌有效期(秒),默认 7 天
# JWT_TTL_SECONDS=604800

# ============================================================
# 日志
# ============================================================
# debug / info / warn / error
# LOG_LEVEL=info
# 留空则只输出到 stdout
# LOG_FILE=logs/app.jsonl
