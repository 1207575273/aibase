# 复制成 .env 后按需修改。所有变量由 server/src/config/index.ts 用 zod 校验,
# 缺失或格式错误会在启动时 fail-fast 并打印具体字段,不会带着错配置跑起来。

# ── 运行环境 ──────────────────────────────────────────────
# development | test | production
NODE_ENV=development


# ── 端口与上下文根 ──────────────────────────────────────────
# 后端、前端 dev server、开发脚本读的是同一份,改这里一处生效。
# 临时换端口不必改文件:PORT=8080 pnpm dev
PORT=7101
WEB_PORT=7102
# 应用挂载的 URL 前缀(类比 Spring 的 server.servlet.context-path)。
# 留空即挂根;设成 /myapp 后 API 变 /myapp/api/*、页面变 /myapp/*,
# 便于一台 nginx 按路径反代多个应用。
CONTEXT_PATH=

# ── 服务监听 ──────────────────────────────────────────────
# 绑定地址。0.0.0.0 = 监听全部网卡,局域网内其他设备(手机、同事电脑)可直接访问,
# 启动日志会列出所有可访问地址。
# 服务是有鉴权的(未登录一律 401),但仍建议只在可信网络里这么开。
# 只想本机访问就改成 127.0.0.1。
HOST=0.0.0.0

# ── 数据库 ────────────────────────────────────────────────
# PostgreSQL 连接串。**必须设置**,不设直接拒绝启动 ——
# 给默认值会让"忘了配"变成"连到了某个意外的库",而迁移是破坏性操作。
#
# 开发态先起数据库容器(pnpm dev 会自动做这件事):
#   docker compose -f deploy/docker-compose.dev.yml up -d
# 端口 7103 与项目的 7101/7102 同段 —— 一台开发机上跑多个项目时不会撞。
DATABASE_URL="postgresql://keel:keel_dev_password@127.0.0.1:7103/keel_dev"


# ── 日志 ──────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=debug

# JSONL 日志文件(相对仓库根)。按天轮转,文件名形如 logs/app.2026-08-27.1.jsonl
# 用 pnpm logs 查询,支持 --trace / --level / --status / --slow 等切片。
# [容器部署] 置空 -> 只输出 stdout,日志交给 k8s/docker 采集
#            (在容器里写文件是反模式,除非挂了卷)。
LOG_FILE=logs/app.jsonl

# 保留多少个轮转文件。按天轮转,约等于保留多少天。
LOG_RETAIN_FILES=14

# 单文件大小上限。当天日志超过它会再切一个,防止某天狂刷出一个巨型文件。
LOG_MAX_FILE_SIZE=50m

# ── 认证 ────────────────────────────────────────────────────
# 登录态是 JWT + Authorization 头,不用 Cookie ——
# 所以这里没有 Cookie 名、Secure 标志、跨源白名单这类配置项,
# 它们连同 origin-guard 一起在改用 JWT 时删掉了。凭证由前端显式携带,
# 换 IP、换域名、明文 HTTP 都能直接用。

# JWT 签名密钥。至少 32 字节。生产必须设,不设直接拒绝启动。
# 生成: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# [注意] 换掉它会让所有已签发的令牌立即失效,全员重新登录。
JWT_SECRET=
# 令牌有效期(秒)。默认 7 天。
# 它同时决定"多久要重新登录"和"改权限后多久生效"——
# 权限固化在令牌里,调短才能让权限变更更快生效,代价是登录更频繁。
JWT_TTL_SECONDS=604800

# ── seed ──────────────────────────────────────────────────
# 初始管理员密码。
# [WARN] 这是模板自带的固定值,方便开箱即用 —— 生产环境必须改掉,
# 或者注释掉本行让 seed 随机生成(会打印一次到控制台)。
SEED_ADMIN_PASSWORD=admin12345
