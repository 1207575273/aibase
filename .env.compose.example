# docker compose 用的环境变量。复制成 deploy/.env 后修改。
#
#   cd deploy && cp ../.env.compose.example .env && docker compose up -d --build
#
# 带 :? 的变量在 compose 里是**必填**,不设直接拒绝启动 ——
# 密钥类的东西宁可启动失败,也不要用一个人尽皆知的默认值跑起来。

# ── 必填 ────────────────────────────────────────────────────
# 数据库密码
POSTGRES_PASSWORD=

# JWT 签名密钥,至少 32 字节。
# 生成: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# [注意] 换掉它会让所有已签发的令牌立即失效,全员重新登录 ——
# 这也是 JWT 方案唯一的全局吊销手段。
JWT_SECRET=

# ── 可选 ────────────────────────────────────────────────────
# 对外端口。与开发态后端端口一致,认知上"服务就在 7101"
APP_PORT=7101

POSTGRES_USER=keel
POSTGRES_DB=keel

# 初始管理员密码。不设则由 seed 随机生成并打印一次(在 docker compose logs migrate 里找)
SEED_ADMIN_PASSWORD=

# 接管已有数据的库、不想让种子碰用户表时设成 1
SKIP_SEED=0

# 令牌有效期(秒)。默认 7 天。
# 它同时决定"多久要重新登录"和"改权限后多久生效"
JWT_TTL_SECONDS=604800

LOG_LEVEL=info

# 应用挂载的 URL 前缀。留空即挂根;设成 /myapp 后 API 与页面前缀一处生效。
# [注意] 改它要同时改 nginx.conf 里的 location —— 两边读的不是同一份配置
CONTEXT_PATH=
