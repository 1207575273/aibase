{
  "name": "aibase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AIBase",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "postinstall": "node scripts/db.mjs generate",
    "dev": "node scripts/dev.mjs",
    "kill": "node scripts/kill.mjs",
    "build": "pnpm -r --parallel build",
    "start": "node server/dist/main.js",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "test": "pnpm -r --filter @app/server --filter @app/contracts test",
    "test:e2e": "pnpm --filter @app/e2e test",
    "test:ui": "pnpm --filter @app/e2e test:ui",
    "verify": "pnpm typecheck && pnpm lint && pnpm build && pnpm test && pnpm test:e2e",
    "db": "node scripts/db.mjs",
    "package": "node scripts/package.mjs",
    "logs": "node scripts/logs.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "8.68.0",
    "eslint": "9.39.4",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "6.0.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "prisma": "7.10.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ],
    "overrides": {
      "prisma": "7.10.0",
      "@prisma/client": "7.10.0",
      "@prisma/adapter-pg": "7.10.0"
    }
  }
}
