# docker compose 用的环境变量。复制成 deploy/.env 后填写:
#   cd deploy && cp .env.compose.example .env && docker compose -f docker-compose.prod.yml up -d --build
# 带 :? 的变量在 compose 里是必填,不设直接拒绝启动。注释掉的是可选项,等号右边是默认值。

# ============================================================
# 必填
# ============================================================
# 数据库密码
POSTGRES_PASSWORD=
# JWT 签名密钥,至少 32 字节。换掉它会让所有已签发的令牌失效
# 生成: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ============================================================
# 服务
# ============================================================
# 对外端口,与开发态后端端口一致
# APP_PORT=7101
# 应用挂载的 URL 前缀;改它要同时改 nginx.conf 的 location
# CONTEXT_PATH=

# ============================================================
# 数据库
# ============================================================
# POSTGRES_USER=keel
# POSTGRES_DB=keel
# schema 名按环境加后缀;prod.yml 默认 keel_prod,test.yml 默认 keel_test
# DATABASE_SCHEMA=keel_prod
# 初始管理员密码。不设则由 seed 随机生成并打印一次(docker compose logs migrate 里找)
# SEED_ADMIN_PASSWORD=
# 接管已有数据的库、不想让种子碰用户表时设成 1
# SKIP_SEED=0

# ============================================================
# 认证与日志
# ============================================================
# JWT_TTL_SECONDS=604800
# LOG_LEVEL=info
