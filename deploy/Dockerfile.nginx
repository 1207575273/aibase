# nginx 镜像 —— 前端静态资源 + 反代。
#
# 为什么把 web/dist **打进镜像**而不是挂 volume:
#   镜像不可变才有意义 —— 一个镜像 tag 对应一份确定的前端产物,
#   回滚就是换 tag。挂 volume 的话"镜像版本"和"里面的文件"是两个变量,
#   出问题时要先搞清楚容器里到底是哪次构建的产物。
#
# 前端构建在这里做而不是复用 app 镜像的 build 阶段: 两个镜像各自独立构建,
# 谁变了只重建谁。前端改一行不需要重打后端镜像。

# ── 阶段 1:构建前端 ────────────────────────────────────────────
FROM node:22-slim AS build
WORKDIR /app

RUN corepack enable

# 只复制依赖清单 —— 业务代码变了不会让这一层缓存失效
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY server/package.json ./server/
COPY web/package.json ./web/
COPY e2e/package.json ./e2e/
COPY packages/contracts/package.json ./packages/contracts/

# --ignore-scripts 跳过 postinstall 的 prisma generate:
# 前端构建用不到 Prisma client,而此刻 schema 文件还没 COPY 进来
RUN pnpm install --frozen-lockfile --ignore-scripts

COPY . .

# vite 的 base 来自 .env 的 CONTEXT_PATH(经 scripts/ports.mjs 读取)。
# 启用 contextPath 时前端产物的资源路径会带上前缀,nginx 的 location 也要跟着改 ——
# 两边都读同一个来源,不会各写各的。
RUN pnpm --filter @app/web build

# ── 阶段 2:运行时 ──────────────────────────────────────────────
FROM nginx:1.27-alpine AS runtime

# [镜像识别标签] 与 app 镜像、compose 容器同一套键: docker images --filter label=app.project=aibase
LABEL app.project="aibase" app.title="AIBase" app.service="nginx"

# 换掉默认站点配置。default.conf 里那个 listen 80 的 server 块必须去掉,
# 否则两个 server 块都监听会导致请求落到哪个取决于顺序,行为不确定。
RUN rm -f /etc/nginx/conf.d/default.conf
COPY deploy/nginx.conf /etc/nginx/conf.d/app.conf

COPY --from=build /app/web/dist /usr/share/nginx/html

EXPOSE 7101

# nginx 官方镜像的 entrypoint 已经处理好了信号转发与 PID 1,
# 这里只要保持前台运行(daemon off)即可,不需要自己写 start.sh。
CMD ["nginx", "-g", "daemon off;"]
