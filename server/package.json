    "@prisma/client": "7.10.0",
    "better-sqlite3": "12.11.1",
    "hono": "4.13.5",
    "pino": "10.3.1",
    "pino-roll": "4.0.0",
    "uuid": "14.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.1",
    "esbuild": "0.28.2",
