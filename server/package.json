{
  "name": "@app/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "后端 — Hono + Prisma 7 + SQLite,轻量 DDD 分层",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
